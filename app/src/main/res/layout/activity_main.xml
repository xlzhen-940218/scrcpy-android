<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:padding="16dp"
        android:orientation="vertical"
        tools:context=".MainActivity">

        <TextView
            android:padding="10dp"
            android:textSize="14sp"
            android:text="要使用scrcpy-android (scrcpy 4.1)，请在被控手机开启网络ADB：\nadb tcpip 5555"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="手机IP与端口 (例如 192.168.0.73 或 192.168.0.73:5555)"
            android:textAppearance="@android:style/TextAppearance" />

        <EditText
            android:id="@+id/editText_server_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="45"
            android:inputType="textUri"
            android:hint="IP 或 IP:端口"
            android:minHeight="48dp"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/button_adb_pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/btn_adb_pair"
            android:textAllCaps="false"
            style="?android:attr/buttonStyleSmall" />

        <TextView
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="传输分辨率"
            android:textAppearance="@android:style/TextAppearance" />

        <Spinner
            android:id="@+id/spinner_video_resolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/options_resolution_values"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="带宽码率"
            android:textAppearance="@android:style/TextAppearance" />

        <Spinner
            android:id="@+id/spinner_video_bitrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/options_bitrate_keys"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_codec"
            android:textAppearance="@android:style/TextAppearance" />

        <Spinner
            android:id="@+id/spinner_video_codec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/options_codec_keys"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_fps"
            android:textAppearance="@android:style/TextAppearance" />

        <Spinner
            android:id="@+id/spinner_max_fps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/options_fps_keys"
            android:minHeight="48dp" />

        <Switch
            android:id="@+id/switch_audio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:text="@string/switch_audio"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switch_stay_awake"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/switch_stay_awake"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switch_screen_off"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/switch_screen_off"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switch0"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/switch0"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switch1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/switch1"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="全屏模式"
                android:textSize="18sp" />

            <Button
                android:id="@+id/button_start_float"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="悬浮窗模式"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
