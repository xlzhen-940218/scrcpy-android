<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- SurfaceView: sized by ConstraintSet ratio, centered in available space -->
    <SurfaceView
        android:id="@+id/decoder_surface"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/nav_button_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constrainedWidth="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintDimensionRatio="H,16:9" />

    <!-- Navigation button bar: anchored to bottom, elevated above video -->
    <LinearLayout
        android:id="@+id/nav_button_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#EE16191A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="visible"
        android:elevation="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Power Button -->
        <ImageView
            android:id="@+id/power_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_power"
            android:contentDescription="@string/power_button" />

        <!-- Back Button -->
        <ImageView
            android:id="@+id/back_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_back"
            android:contentDescription="@string/back_button" />

        <!-- Home Button -->
        <ImageView
            android:id="@+id/home_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_home"
            android:contentDescription="@string/home_button" />

        <!-- App Switch / Recents -->
        <ImageView
            android:id="@+id/appswitch_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_tasks"
            android:contentDescription="@string/appswitch_button" />

        <!-- Volume Down -->
        <ImageView
            android:id="@+id/vol_down_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_vol_down"
            android:contentDescription="@string/voldown_button" />

        <!-- Volume Up -->
        <ImageView
            android:id="@+id/vol_up_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_vol_up"
            android:contentDescription="@string/volup_button" />

        <!-- Rotate Button -->
        <ImageView
            android:id="@+id/rotate_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_btn_ripple"
            android:src="@drawable/ic_nav_rotate"
            android:contentDescription="@string/rotate_button" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
